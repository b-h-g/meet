# Optional. When unset, bookings are still saved and the server logs
# "Booking invite webhook was not configured".
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_KEY=

# Read-write token for the private Vercel Blob store. On Vercel this is set
# by the connected store. Locally, bookings are written to .data/bookings.
BLOB_READ_WRITE_TOKEN=
